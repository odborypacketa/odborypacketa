rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /bozp-records/{recordId}/{fileName} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.enabled == true;
    }
  }
}
